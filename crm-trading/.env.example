# Copia este archivo como .env.local y completa con tus credenciales de Supabase
# Las encontrarás en: Supabase → Settings → API

VITE_SUPABASE_URL=https://TU_PROJECT_ID.supabase.co
VITE_SUPABASE_ANON_KEY=TU_ANON_KEY_AQUI

# Server-only — NUNCA usar prefijo VITE_ (se expondrían en el bundle del cliente).
# Solo las leen las funciones serverless en /api. Se obtienen en:
# Supabase → Settings → API → JWT Settings (Legacy JWT Secret) y → service_role key
SUPABASE_JWT_SECRET=TU_JWT_SECRET_AQUI
SUPABASE_SERVICE_ROLE_KEY=TU_SERVICE_ROLE_KEY_AQUI
