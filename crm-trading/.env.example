# Copia este archivo como .env.local y completa con tus credenciales de Supabase
# Las encontrarás en: Supabase → Settings → API

VITE_SUPABASE_URL=https://TU_PROJECT_ID.supabase.co
VITE_SUPABASE_ANON_KEY=TU_ANON_KEY_AQUI

# Server-only — NUNCA usar prefijo VITE_ (se expondrían en el bundle del cliente).
# Solo las leen las funciones serverless en /api. Se obtienen en:
# Supabase → Settings → API → JWT Settings (Legacy JWT Secret) y → service_role key
SUPABASE_JWT_SECRET=TU_JWT_SECRET_AQUI
SUPABASE_SERVICE_ROLE_KEY=TU_SERVICE_ROLE_KEY_AQUI

# Plan Reactivate Burs — envío de correos automático (api/reactivate-cron.js)
# GMAIL_USER: el Gmail desde el que se enviarán los correos (remitente real).
# GMAIL_APP_PASSWORD: contraseña de aplicación de 16 caracteres, generada en
#   https://myaccount.google.com/apppasswords (requiere verificación en 2 pasos).
GMAIL_USER=tucorreo@gmail.com
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx
# Dominio público donde está desplegado el CRM (sin / al final). Se usa para
# construir los enlaces de tracking de apertura/clic embebidos en los correos.
PUBLIC_APP_URL=https://tu-dominio-en-vercel.app
# Header que Vercel agrega automáticamente al invocar los crons — protege los
# endpoints /api/sync-programas-encuestas y /api/reactivate-cron de invocaciones
# externas no autorizadas. Cualquier valor secreto propio sirve.
CRON_SECRET=un-valor-secreto-cualquiera
